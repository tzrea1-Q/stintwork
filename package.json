{
  "name": "stintwork-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "stintwork": "node --import tsx --conditions=development packages/cli/src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "licence:check": "node scripts/check-licence-headers.mjs",
    "lint": "node scripts/check-licence-headers.mjs && biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
